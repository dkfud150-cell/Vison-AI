# 이 파일을 .env 로 복사해서 값을 채운다. (.env 는 깃에 올리지 말 것)

# mock | claude | openai
LLM_PROVIDER=mock

# Claude 를 쓸 때
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# OpenAI 를 쓸 때 — 이미지 입력을 지원하는 모델명을 적는다
OPENAI_API_KEY=
OPENAI_MODEL=

# 예시 데이터(../예시데이터_삭제가능/ — 샘플 이벤트 · 허가서 · 제보 · 조정 · 시연 날짜)를 같이 읽을지 — on | off
# 폴더를 지우면 이 값과 상관없이 안 읽는다. 폴더는 두고 잠깐 끄기만 할 때 off
DOCGEN_SAMPLE_DATA=on
